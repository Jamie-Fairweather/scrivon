{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Scrivon",
    "mainBinaryName": "scrivon",
    "version": "1.4.2",
    "identifier": "io.github.jamie-fairweather.scrivon",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:3000",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../out"
    },
    "app": {
        "windows": [
            {
                "title": "Scrivon",
                "width": 1440,
                "height": 810,
                "minWidth": 640,
                "minHeight": 480,
                "center": true,
                "preventOverflow": true,
                "decorations": false,
                "backgroundColor": "#161616"
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "createUpdaterArtifacts": true,
        "publisher": "github",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "webviewInstallMode": {
                "type": "embedBootstrapper"
            },
            "wix": {
                "upgradeCode": "2671e548-9e53-5d3e-93c1-5be896bc07d0"
            },
            "nsis": {
                "installerHooks": "./windows/installer-hooks.nsh"
            }
        }
    },
    "plugins": {
        "updater": {
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4RUEyRTdFNDU0NTY4MkUKUldRdWFFVkZmaTdxS0xjU2hWZktwRm9tbklGNWhFOC9EUHJWQjc1R2paZmExL25FREFpRkovTmwK",
            "endpoints": [
                "https://github.com/Jamie-Fairweather/scrivon/releases/latest/download/latest.json"
            ],
            "windows": {
                "installMode": "passive"
            }
        }
    }
}
