        "@vitest/coverage-v8": "^5.1.0",
        "conventional-changelog-conventionalcommits": "^9.3.1",
        "eslint": "^10.14.0",
        "eslint-config-next": "^16.4.5",
        "happy-dom": "^21.0.4",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-classnames": "^0.10.5",
        "prettier-plugin-merge": "^0.10.2",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "semantic-release": "^25.0.9",
        "typescript": "~6.0.3",
        "vitest": "^5.1.0",
        "yaml": "^2.9.1"
    },
    "overrides": {
        "dompurify": "^3.4.17",
        "postcss": "^8.5.32",
        "vite": "^8.3.6",
        "js-yaml": "^4.3.2",
        "@babel/core": "^7.29.13",
        "tar": "^7.5.22"
    }
