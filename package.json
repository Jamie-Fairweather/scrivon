{
    "name": "scrivon",
    "private": true,
    "version": "1.5.0",
    "license": "MIT",
    "packageManager": "bun@1.4.2",
    "type": "module",
    "scripts": {
        "dev": "next dev -p 3000",
        "prebuild": "node scripts/generate-examples.mjs",
        "build": "node scripts/next-build.mjs",
        "postbuild": "node scripts/generate-licenses.mjs",
        "tauri": "node scripts/tauri-cli.mjs",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write \"**/*.{ts,tsx,md,mjs,json,css}\"",
        "generate:examples": "node scripts/generate-examples.mjs",
        "generate:licenses": "node scripts/generate-licenses.mjs",
        "release": "semantic-release",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx,mjs}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{md,json,css}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@monaco-editor/react": "^4.7.0",
        "@tailwindcss/postcss": "^4.3.5",
        "@tauri-apps/api": "^2.12.4",
        "@tauri-apps/plugin-dialog": "^2.8.4",
        "@tauri-apps/plugin-fs": "^2.7.1",
        "@tauri-apps/plugin-opener": "^2.7.2",
        "@tauri-apps/plugin-process": "^2.4.0",
        "@tauri-apps/plugin-store": "^2.5.0",
        "beautiful-mermaid": "^1.1.3",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dictionary-en": "^4.0.0",
        "dictionary-en-gb": "^3.0.0",
        "docx": "^9.15.3",
        "hast-util-to-html": "^9.0.6",
        "lucide-react": "^1.70.0",
        "mdast-util-math": "^3.0.0",
        "micromark-extension-math": "^3.1.0",
        "monaco-editor": "^0.57.0",
        "next": "^16.4.5",
        "nspell": "^2.1.5",
        "postcss": "^8.5.32",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "rehype-katex": "^7.0.1",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-cjk-friendly": "^2.3.4",
        "remark-cjk-friendly-gfm-strikethrough": "^2.3.3",
        "remark-gfm": "^4.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "shiki": "^4.6.0",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.4.0",
        "unified": "^11.0.5",
        "unist-util-visit": "^5.2.0"
